# === Sekolahku — Contoh Environment Produksi ===
# Salin file ini ke /opt/sekolahku-prod/.env.prod dan isi nilainya.
# Jangan pernah commit secret asli ke git!

# === Application ===
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://sdn1kenanga.sch.id
NEXT_PUBLIC_APP_NAME="Website Sekolah Terpadu"
NEXT_PUBLIC_API_URL=https://sdn1kenanga.sch.id/api

# === Security (WAJIB) ===
# Generate dengan: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_ke_64_karakter_hex_random
COOKIE_SECURE=true

# === Gemini AI (fitur AI) ===
GEMINI_API_KEY=

# === Telegram Local API (bot notifikasi) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Untuk container podman rootless (networking pasta), host dijangkau lewat
# host.containers.internal. Ganti ke http://telegram-bot-api:8081 bila pakai
# docker-compose dengan network bersama.
TELEGRAM_API_URL=http://host.containers.internal:8081

# === Cloud Storage (backend: Telegram Bot API lokal) ===
# Bot token dari @BotFather + chat_id tujuan penyimpanan (grup/channel).
# Selama kosong, fitur upload Cloud Storage nonaktif (halaman tetap tampil).
CLOUDSTORAGE_BOT_TOKEN=
CLOUDSTORAGE_CHAT_ID=
# Batas ukuran upload per berkas (MB). Default 2048 (2GB, batas Bot API).
CLOUDSTORAGE_MAX_UPLOAD_MB=2048
# Folder cache thumbnail (relatif ke workdir container).
CLOUDSTORAGE_THUMB_DIR=./data/cloud-thumbs
# Direktori kerja upload bertahap (potongan sementara file besar).
# WAJIB diarahkan ke volume persisten (mis. ./data/...) — JANGAN /tmp:
# di container /tmp adalah tmpfs kecil (64MB) sehingga upload file besar
# gagal "no space left on device". Default kode: ./data/cloud-uploads.
CLOUDSTORAGE_CHUNK_DIR=./data/cloud-uploads
# Enkripsi at-rest AES-256-GCM (64 karakter hex). Kosong = nonaktif.
# PENTING: bila diaktifkan, HTTP Range/preview langsung tidak didukung dan
# kunci hilang = berkas tidak dapat dipulihkan.
CLOUDSTORAGE_ENCRYPTION_KEY=


# === Backup Telegram (enkripsi) ===
# Password backup harian. Backup (DB + foto/PII siswa) dienkripsi AES-256-GCM
# sebelum dikirim ke Telegram. TANPA ini, backup terkirim plain — jangan kosong.
# Generate dengan: openssl rand -base64 32
# Simpan baik-baik: tanpa password ini, backup TIDAK BISA dipulihkan.
BACKUP_ZIP_PASSWORD=

# === CORS / CSRF (asal yang diizinkan) ===
EXTRA_ALLOWED_ORIGINS=https://sdn1kenanga.sch.id

# === Google Sign-In / Sign-Up (khusus orang tua) ===
# Kosong = fitur nonaktif (tombol Google tidak ditampilkan, endpoint 503).
# Buat OAuth Client tipe "Web application" di Google Cloud Console.
# Redirect URI yang WAJIB didaftarkan (persis):
#   https://sdn1kenanga.sch.id/api/auth/google/callback
# Untuk dev lokal: http://localhost:3001/api/auth/google/callback
# Google menolak http:// non-localhost, jadi staging via IP tidak bisa dipakai.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Basis URL publik untuk menyusun redirect_uri. Harus sama dengan yang
# didaftarkan di Google (tanpa garis miring di akhir).
# Produksi: https://sdn1kenanga.sch.id | Dev lokal: http://localhost:3001
OAUTH_PUBLIC_BASE_URL=https://sdn1kenanga.sch.id

# === DocStation (scan eSCL & cetak IPP/RAW ke printer LAN) ===
# Daftar printer: "ip:nama" dipisah koma. Suffiks ":s" menandai https-first.
# Kosong = pakai daftar default bawaan (Canon 192.168.10.131, Epson 192.168.10.140).
DOCSTATION_PRINTERS=
# IP printer default (harus salah satu yang terdaftar). Kosong = printer pertama.
DOCSTATION_DEFAULT_PRINTER=
# Daftar IP printer yang memakai HTTPS (koma-dipisah), mis. 192.168.10.140
DOCSTATION_SECURE_PRINTERS=
# Folder simpan hasil scan di server. Default uploads/docstation (di dalam
# volume uploads, aman pada container read-only). Jangan arahkan ke root fs.
DOCSTATION_UPLOAD_DIR=uploads/docstation

# === Web Push (PWA) — WAJIB agar notifikasi ortu aktif ===
# Generate dengan: cloudflared tidak terkait; pakai npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sdn1kenanga.sch.id

# === Default Map (Indonesia - Jakarta) ===
NEXT_PUBLIC_DEFAULT_LAT=-6.200000
NEXT_PUBLIC_DEFAULT_LNG=106.816666
NEXT_PUBLIC_DEFAULT_ZOOM=13
