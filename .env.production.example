# === PocketBase Configuration ===
# URL untuk akses dari browser (client-side)
NEXT_PUBLIC_POCKETBASE_URL=http://YOUR_SERVER_IP:8092

# URL untuk akses dari Docker network (server-side)
POCKETBASE_URL=http://pocketbase:8080

# === Application Configuration ===
NEXT_PUBLIC_APP_URL=http://YOUR_DOMAIN_OR_IP:3000
NEXT_PUBLIC_APP_NAME="Website Sekolah Terpadu"
GEMINI_API_KEY=your_gemini_api_key_here

# === Telegram Local API ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# === Default Map Configuration (Indonesia - Jakarta) ===
NEXT_PUBLIC_DEFAULT_LAT=-6.200000
NEXT_PUBLIC_DEFAULT_LNG=106.816666
NEXT_PUBLIC_DEFAULT_ZOOM=13

# === Security (Production) ===
NODE_ENV=production

# === Web Push (PWA) ===
# Kunci VAPID untuk notifikasi push tanpa pihak ketiga. Wajib diisi agar
# fitur notifikasi ortu aktif. Rahasiakan PRIVATE_KEY.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@sdn1kenanga.sch.id
